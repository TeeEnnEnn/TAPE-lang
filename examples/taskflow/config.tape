// TaskFlow shared configuration.
//
// These literal constants are shared across every module of the demo.
// Only literals (numbers, strings, booleans, nil) may be exported with
// `pub const`, so all configuration lives here as plain values.
pub const APP_NAME = "TaskFlow";
pub const APP_VERSION = 3;
pub const MAX_TASKS = 8;
pub const MAX_USERS = 4;
pub const MAX_ESTIMATE = 40;
pub const SEED_TASKS = 5;
